{
  "compilerOptions": {
    "target": "es6",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@gen3/frontend/pages/StudyForms/StudyRegistration": [
        "./node_modules/@gen3/frontend/dist/dts/pages/StudyForms/StudyRegistration/index"
      ],
      "@gen3/frontend/pages/StudyForms/StudyRegistration/data": [
        "./node_modules/@gen3/frontend/dist/dts/pages/StudyForms/StudyRegistration/data"
      ],
      "@gen3/frontend/pages/StudyForms/StudyRegistrationAccessRequest": [
        "./node_modules/@gen3/frontend/dist/dts/pages/StudyForms/StudyRegistrationAccessRequest/index"
      ],
      "@gen3/frontend/pages/StudyForms/StudyRegistrationAccessRequest/data": [
        "./node_modules/@gen3/frontend/dist/dts/pages/StudyForms/StudyRegistrationAccessRequest/data"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.stories.ts",
    "**/*.stories.tsx"
  ]
}
